# ===== Supabase (mismo proyecto que el backend) =====
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# ===== Stockfish =====
# Ruta al binario. Si está en el PATH, dejar simplemente "stockfish".
# Linux:    apt install stockfish    -> /usr/games/stockfish (Debian/Ubuntu) o /usr/bin/stockfish
# macOS:    brew install stockfish   -> /opt/homebrew/bin/stockfish
# En Render: añadir a build command: "apt-get update && apt-get install -y stockfish"
STOCKFISH_PATH=stockfish

# Profundidad de análisis (12-15 razonable). Más alto = más preciso pero más lento.
ENGINE_DEPTH=12

# Cuántas líneas devolver por posición (top-N continuaciones)
ENGINE_MULTIPV=3

# Cada cuánto pollear la cola (ms)
POLL_INTERVAL_MS=4000

# Máximo de plies a analizar por partida (corta partidas muy largas)
MAX_PLIES=200
