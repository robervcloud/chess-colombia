# ===== Servidor =====
PORT=4000
NODE_ENV=development

# ===== Frontend (CORS y Socket.io) =====
# En desarrollo local: http://localhost:3000
# En producción: la URL de Vercel sin slash final
CLIENT_ORIGIN=http://localhost:3000

# ===== Supabase =====
# Sacar de: https://app.supabase.com/project/<proyecto>/settings/api
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...   # service_role key (NUNCA exponer al cliente)

# ===== JWT =====
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# ===== Google OAuth (opcional) =====
# Si está vacío, /api/auth/google responde 503.
# Sacar de https://console.cloud.google.com/apis/credentials -> "OAuth 2.0 Client IDs"
# Tipo: "Web application". Usar el MISMO Client ID en el frontend.
GOOGLE_CLIENT_ID=
